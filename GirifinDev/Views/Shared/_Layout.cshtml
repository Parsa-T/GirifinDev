<!Doctype html>
<html class="" lang="fa-IR" dir="rtl">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="keywords" content="Griffin , شیر ایرانی , تیم برنامه نویسی , طراحی وب ">
    <meta name="author" content="گیریفین , Griffin">
    <meta name="description" content="تیم برنامه نویسی گیریفین دو">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/Layout/assets/css/style.css" />
    <link rel="Web icon" type="ico" href="/favicon.ico" />
    <link rel="stylesheet" href="/Layout/dist/output.css">
    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.45/dist/ionicons/ionicons.js"></script>
    <link rel="stylesheet" href="/Layout/assets/fonts/fontawesome-free-6.1.1-web/css/all.min.css">
    <link href='https://unpkg.com/css.gg@2.0.0/icons/css/git-pull.css' rel='stylesheet'>
</head>

<body>

    <div class="main">
        <!-- Header -->
        <header id="header" class="header z-50 fixed top-0 flex flex-col">
            <div class="container transition-low h-full p-2 laptop:w-full  mx-auto pt-2 flex justify-between ">
                <a class="icon-list" id="hamberger">
                    <i class="fa fa-list" aria-hidden="true"></i>
                </a>
                <ul class="nav-ul">
                    <li class="list-nav"><a href="" id="active" onclick="smoothScroll(event)">خانه</a></li>
                    <li class="list-nav"><a href="#AboutTeam" onclick="smoothScroll(event)">درباره ما</a></li>
                    <li class="list-nav"><a href="#services" onclick="smoothScroll(event)">سرویس ها</a></li>
                    <li class="list-nav"><a href="#Project" onclick="smoothScroll(event)">نمونه کار</a></li>
                    @*                     <li class="list-nav"><a href="#Amount" onclick="smoothScroll(event)">قیمت ها</a></li> *@
                    <li class="list-nav"><a href="#Score" onclick="smoothScroll(event)">ویژگی ها</a></li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="list-nav"><a href="/Account/Loguot">خروج</a></li>
                    }
                    <li class="list-nav"><a href="#ContactUs" onclick="smoothScroll(event)">تماس با ما</a></li>
                </ul>
                <a href="/" class="logo">
                    @* <img src="/Layout/assets/img/sample/logo-theme.png" class="w-full " alt=""> *@
                    <p style="z-index: 999;color: #fff;font-size: 30px;font-weight: bold;">
                        <span style="
                         color: #09b9bb;
                         font-size: 30px;
                         font-weight: bold;
                         margin: 7px;
                        ">Griffin</span>Dev
                    </p>
                </a>
            </div>
            <div class="menu-ham transform-full z-50 absolute top-full">
                <ul class="">
                    <li class="list-nav"><a href="" id="active" onclick="smoothScroll(event)">خانه</a></li>
                    <li class="list-nav"><a href="#AboutTeam" onclick="smoothScroll(event)">درباره ما</a></li>
                    <li class="list-nav"><a href="#services" onclick="smoothScroll(event)">سرویس ها</a></li>
                    <li class="list-nav"><a href="#Project" onclick="smoothScroll(event)">نمونه کار</a></li>
                    @* <li class="list-nav"><a href="#Amount" onclick="smoothScroll(event)">قیمت ها</a></li> *@
                    <li class="list-nav"><a href="#Score" onclick="smoothScroll(event)">ویژگی ها</a></li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="list-nav"><a href="/Admin">پنل مدیریت</a></li>
                        <li class="list-nav"><a href="/Account/Loguot">خروج</a></li>
                    }
                    <li class="list-nav"><a href="#ContactUs" onclick="smoothScroll(event)">تماس با ما</a></li>
                </ul>
            </div>
        </header>

        <!-- End Header -->
        <!-- banner -->
        <section class="banner-content tablet:h-auto h-screen px-[15px] py-[30px]">
            <div class="container h-full gap-[1.75rem] flex flex-col justify-center items-center  ipad:py-[20px]">
                <h1 class="title-lg title"><span class="title-inner text-hover"> Griffin</span> Dev</h1>
                <p class="des-content laptop:w-full">کدهای هماهنگ، راه‌های پیشرفت؛ همکاری در تیم، آینده‌ای روشن!</p>


                <a href="#AboutTeam" class="btn-info transition-low hover:bg-hover" onclick="smoothScroll(event)">
                    اطلاعات بیشتر
                </a>

            </div>
        </section>
        <!-- End banner -->
        <!-- Advertising section of the site -->

        <section class="overlay relative">
            <div class="section bg-primary  w-full h-full  gap-[1.75rem] flex  flex-col justify-center items-center   ipad:py-[20px] ">

                <h2 class="title-md  title">
                    ما آنچه را که
                    شما نیاز دارید در اختیار
                    داریم!
                </h2>
                <p class="des-content  laptop:w-full">
                    برای هر بخش از توسعه سایت، ما ابزارها و تجربیات لازم را در اختیار داریم تا به بهترین نحو به نیازهای شما پاسخ دهیم و یک سایت با کیفیت بالا را تحویل دهیم
                </p>

                <a href="#services" onclick="smoothScroll(event)" class="btn-info bg-white text-hover hover:bg-transparent hover:text-white transition-low">
                    اطلاعات بیشتر
                </a>



            </div>
        </section>

        <!-- End Advertising section of the site -->
        <!-- who are we section -->

        <section id="AboutTeam" class="about-we bg-white px-[15px]">
            <div class="container  flex   my-[20px] ">
                <div class="image-how">
                    <img src="/Layout/assets/img/sample/about1.png" class=" h-full" alt="">
                </div>
                <div class="description-we">
                    <div class="des-about">

                        <h2 class="title-sm title-third text-black-text text-right font-normal pb-3 ">
                            ما کی
                            هستیم
                        </h2>

                        <p class=" des-content text-right w-full text-black-text line-clamp-[3]">
                            تیم برنامه‌نویسی ما به عنوان یک گروه حرفه‌ای و پیشرو در صنعت تکنولوژی، به طراحی و توسعه وبسایت‌های حرفه‌ای و پاسخگو متعهد است. با ترکیب تجربه‌های چندین ساله در زمینه‌های مختلف توسعه وب، تیم ما توانسته است به عنوان یک نیروی قوی و قابل اعتماد در بازار کار معرفی شود.
                        </p>
                    </div>
                    <div class="list-about">
                        <h2 class="title-sm title-third text-black-text text-right font-normal pb-3 mt-0 ">
                            آنچه ما
                            انجام می دهیم
                        </h2>

                        <ul class="about-ul mr-[20px] mb-[80px]">

                            <li class="about-list">
                                <ion-icon name="star-outline"
                                          class="io-icon w-[5%] galaxy:w-[7%] ipad:w-[10%]"></ion-icon>
                                <span class="px-4 w-[95%] galaxy:w-[93%] ipad:w-[90%]">تحلیل و طراحی سیستم</span>
                            </li>

                            <li class="about-list">
                                <ion-icon name="star-outline"
                                          class="io-icon w-[5%] galaxy:w-[7%] ipad:w-[10%]"></ion-icon>
                                <span class="px-4 w-[95%] galaxy:w-[93%] ipad:w-[90%]">توسعه فرانت‌اند</span>
                            </li>

                            <li class="about-list">
                                <ion-icon name="star-outline"
                                          class="io-icon w-[5%] galaxy:w-[7%] ipad:w-[10%]"></ion-icon>
                                <span class="px-4 w-[95%] galaxy:w-[93%] ipad:w-[90%]">توسعه بک‌اند</span>
                            </li>

                            <li class="about-list">
                                <ion-icon name="star-outline"
                                          class="io-icon w-[5%] galaxy:w-[7%] ipad:w-[10%]"></ion-icon>
                                <span class="px-4 w-[95%] galaxy:w-[93%] ipad:w-[90%]">تست و ارزیابی</span>
                            </li>

                            <li class="about-list">
                                <ion-icon name="star-outline"
                                          class="io-icon w-[5%] galaxy:w-[7%] ipad:w-[10%]"></ion-icon>
                                <span class="px-4 w-[95%] galaxy:w-[93%] ipad:w-[90%]">نگهداری و بهبود</span>
                            </li>

                        </ul>


                        <a id="read-more-btn"
                           class="btn-info transition-low  border-hover text-hover hover:bg-hover hover:text-white">
                            بیشتر بخوانید
                        </a>

                        <div class="popup" id="popup">
                            <div class="popup-content">
                                <span class="close-btn" id="close-btn">&times;</span>
                                <p class="p-modal">
                                    تیم برنامه‌نویسی ما به عنوان یک گروه حرفه‌ای و پیشرو در صنعت تکنولوژی، به طراحی و توسعه وبسایت‌های حرفه‌ای و پاسخگو متعهد است. با ترکیب تجربه‌های چندین ساله در زمینه‌های مختلف توسعه وب، تیم ما توانسته است به عنوان یک نیروی قوی و قابل اعتماد در بازار کار معرفی شود.

                                    اعضای تیم ما از برنامه‌نویسان با تخصص‌های گوناگونی همچون HTML، CSS، JavaScript، C#، ASP.NET Core MVC و TSQL تشکیل شده‌اند. این ترکیب چندرشته‌ای به ما امکان می‌دهد تا وبسایت‌هایی با عملکرد بالا، ظاهر بصری جذاب و کاربرپسندی بالا ایجاد کنیم.

                                    تیم ما به طور خاص بر آن است تا با استفاده از بهترین شیوه‌های صنعتی و ابزارهای پیشرفته، وبسایت‌هایی را طراحی کنیم که نه تنها به خوبی با نیازهای کاربران مطابقت دارند، بلکه به طور پیوسته بهبود و تکامل می‌یابند. این تعهد به کیفیت و اصول حرفه‌ای باعث شده است که تیم ما بتواند در بین مشتریان و کارفرمایان خود، نام خوبی برای خدمات با کیفیت و پاسخگویی بالا بسازد.

                                    در کنار توسعه فنی، تیم ما به طور فعال در حال یادگیری و پیگیری رویکردهای نوین در طراحی وب هستیم. این تلاش مداوم برای بهره‌برداری از آخرین فناوری‌ها و تکنیک‌ها، تیم ما را قادر می‌سازد تا بتوانیم به عنوان یک نهاد پیشگام در صنعت تکنولوژی وب معرفی شویم.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>


        <!-- End who are we section -->
        <!-- Advertising -->

        <section class="Advertising bg-adv-1">
