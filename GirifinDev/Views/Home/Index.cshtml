            <div class="location  my-[20px] h-full flex justify-center flex-col items-center ">
                <i class="  text-[36px] flex justify-center items-end py-[20px]">
                    <ion-icon name="location-outline" class=" text-[30px] text-hover"></ion-icon>
                </i>
                <span class="flex justify-center items-center">
                    ایران
                </span>
                <span class=" flex justify-center items-center">
                    ایران
                </span>
            </div>
            <div class="email  my-[20px] h-full flex justify-center flex-col items-center ">
                <i class=" text-[36px] flex justify-center items-end py-[20px]">
                    <ion-icon name="mail-outline" class=" text-[30px] text-hover"></ion-icon>

                </i>
                <span class=" flex justify-center items-center">
                    girrifindev@gmail.com
                </span>
            </div>


            <div class="phone  my-[20px]  flex justify-center flex-col items-center">
                <i class=" text-[36px] flex justify-center items-end py-[20px]">
                    <ion-icon name="call-outline" class=" text-[30px] text-hover"></ion-icon>
                </i>
                <p class=" text-[16px] flex justify-center items-center">
                    989057757319+
                </p>
                <p class=" flex justify-center items-center">
                    989057757319+
                </p>
            </div>
        </div>

        <form method="post" enctype="multipart/form-data" class="send-massage w-auto flex items-center flex-col pc:w-full my-[60px] mx-auto">

            <div class="top-mass w-[60%] laptop:w-full flex items-center laptop:flex-col justify-between h-[30%]">
                <input asp-for="Email" id="txtEmail" placeholder="ایمیل" class="input-mass w-[45%] laptop:w-full">
                <input asp-for="Name" id="textName" placeholder="نام" class="input-mass w-[45%] laptop:w-full">
            </div>

            <textarea asp-for="comment" class="w-[60%] laptop:w-full my-[40px]" placeholder="پیام" id="txtComment" cols="10"
                      rows="10"></textarea>


            <input class="btn-info text-center transition-low border-hover text-hover hover:bg-hover hover:text-white "
                   value="ارسال پیام" type="submit" id="subclick"></input>


        </form>
    </div>

</section>
@section Scripts {
    <script>
        $(document).ready(function () {
            $("#subclick").click(function () {
                var name = $("#textName").val();
                var email = $("#txtEmail").val();
                var comment = $("#txtComment").val();
                $.ajax({
                    type: "POST",
                    url: "/Home/index",
                    data: { name: name, email: email, comment: comment },
                });
                if (!name && !email && !comment) {
                    alert("ارسال پیام با شکست مواجه شد");
                } else {
                    alert("پیام با موفقیت ثبت شد");
                }
            });
        });
        document.addEventListener("DOMContentLoaded", function () {
            const buttons = document.querySelectorAll(".portfolio-btn");
            const projectContainer = document.getElementById("portfolio-img-box");

            buttons.forEach(button => {
                button.addEventListener("click", function (event) {
                    event.preventDefault();
                    const categoryId = button.getAttribute("data-category");

                    // Remove bg-hover class from all buttons
                    buttons.forEach(btn => btn.classList.remove("bg-hover"));
                    buttons.forEach(btn => btn.classList.remove("text-white"));
                    // Add bg-hover class to the clicked button
                    button.classList.add("bg-hover");
                    button.classList.add("text-white");

                    fetch(`/Home/GetProjectsByCategory?categoryId=${categoryId}`)
                        .then(response => {
                            if (!response.ok) {
                                throw new Error(`HTTP error! Status: ${response.status}`);
                            }
                            return response.json();
                        })
                        .then(data => {
                            if (!data || data.length === 0) {
                                projectContainer.innerHTML = "<p>هیچ پروژه‌ای یافت نشد.</p>";
                            } else {
                                projectContainer.innerHTML = ""; // Clear the container
                                data.forEach(project => {
                                    const projectElement = document.createElement("div");
                                    projectElement.classList.add("portfolio-img", "transition-low");
                                    projectElement.innerHTML = `
                                                                                                        <img src="/AdminPanel/ProjectPanel/${project.imageUrl}" class="w-full h-full" alt="">
                                                                                                        <div class="portfolio-content black-section-bg">
                                                                                                            <h3 class="title-sm text-white">${project.name}</h3>
                                                                                                            <p class="des-content w-[95%] p-[5px]">
                                                                                                                ${project.description}
                                                                                                            </p>
                                                                                                            <a href="${project.link}" class="popup transition-low">
                                                                                                                <ion-icon name="contract-outline"></ion-icon>
                                                                                                            </a>
                                                                                                        </div>`;
                                    projectContainer.appendChild(projectElement);
                                });
                            }
                        })
                        .catch(error => {
                            console.error('Error fetching projects:', error);
                            projectContainer.innerHTML = "<p>خطایی رخ داده است. لطفا دوباره تلاش کنید.</p>";
                        });
                });
            });
        });
    </script>
}