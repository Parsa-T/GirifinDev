@page
@model GirifinDev.Pages.Admin.CategoryProject.IndexModel
@{
    ViewBag.Title = "عناوین پروژه";
}

<p>
    <a asp-page="Add" class="btn btn-success">عنوان جدید</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>عنوان</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.GetAllCategory)
        {
            <tr>
                <td>
                    @item.Title
                </td>
                <td>
                    <a asp-page="Edit" asp-route-id="@(item.Id)" class="btn btn-warning">ویرایش</a>
                    <a asp-page="Delete" asp-route-id="@(item.Id)" class="btn btn-danger">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>