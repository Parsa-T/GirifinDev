@page
@model GirifinDev.Pages.Admin.ProjectPanel.IndexModel
@{
    ViewBag.Title = "مدیریت پروژه ها";
}

<p>
    <a asp-page="Add" class="btn btn-success">پروژه جدید</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>گروه پروژه</th>
            <th>عکس پروژه</th>
            <th>نام پروژه</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.GetAllProject)
        {
            <tr>
                <td>
                    @item.CategoryProject.Title
                </td>
                <td>
                    <img src="/AdminPanel/ProjectPanel/@(item.ImageUrl)" class="thumbnail" style="max-width:120px" />
                </td>
                <td>
                    @item.Name
                </td>
                <td>
                    <a asp-page="Edit" asp-route-id="@(item.Id)" class="btn btn-warning">ویرایش</a>
                    <a asp-page="Delete" asp-route-id="@(item.Id)" class="btn btn-danger">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>